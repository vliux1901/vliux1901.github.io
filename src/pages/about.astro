---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const description = 'Personal airgun impressions, practical comparisons, and measured results from an enthusiast.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p>
				AIR &amp; PELLETS is my space to explore airguns through testing, analysis,
				and personal experience. I share the designs that catch my eye, comparisons
				between pistols, and measurements that help put factory specifications in context.
			</p>
			<p>
				The aim is to give fellow airgun enthusiasts an honest look at what I find
				interesting, what I learn, and how these airguns perform in my hands—with
				photos, practical observations, and results you can examine for yourself.
			</p>
			<p><a href="/">Read the blog</a></p>
		</main>
		<Footer />
	</body>
</html>
