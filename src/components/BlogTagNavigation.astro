---
import { type BlogTag, tagPath } from '../tags';

interface Props {
	tags: { tag: BlogTag; count: number }[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
	<aside class="tag-sidebar">
		<nav class="desktop-tags" aria-label="Browse by tag">
			<p class="label">Browse by tag</p>
			<ul>
				{tags.map(({ tag, count }) => (
					<li><a href={tagPath(tag)}><span>{tag}</span><span class="count">{count}<span class="sr-only"> {count === 1 ? 'post' : 'posts'}</span></span></a></li>
				))}
			</ul>
		</nav>
		<details class="mobile-tags">
			<summary>Browse by tag</summary>
			<nav aria-label="Browse by tag">
				<ul>
					{tags.map(({ tag, count }) => (
						<li><a href={tagPath(tag)}><span>{tag}</span><span class="count">{count}<span class="sr-only"> {count === 1 ? 'post' : 'posts'}</span></span></a></li>
					))}
				</ul>
			</nav>
		</details>
	</aside>
)}

<style>
	.tag-sidebar {
		min-width: 0;
		font-size: 1rem;
		line-height: 1.4;
	}
	.desktop-tags {
		display: none;
	}
	.mobile-tags {
		margin-bottom: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: white;
	}
	summary {
		padding: 0.85rem 1rem;
		cursor: pointer;
		font-weight: 700;
	}
	.label {
		margin: 0 0 0.75rem;
		font-weight: 700;
		color: rgb(var(--black));
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.mobile-tags ul {
		padding: 0 0.5rem 0.5rem;
	}
	a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		box-sizing: border-box;
		min-height: 44px;
		padding: 0.6rem 0.5rem;
		border-left: 2px solid transparent;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.count {
		flex-shrink: 0;
		color: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
	}
	a:hover {
		color: var(--accent);
		border-left-color: var(--accent);
		background: rgba(var(--gray-light), 40%);
	}
	a:focus-visible,
	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	@media (min-width: 1320px) {
		.tag-sidebar {
			position: sticky;
			top: 1.5rem;
			max-height: calc(100dvh - 3rem);
			overflow-y: auto;
			box-sizing: border-box;
			padding: 1.25rem 1rem 0.25rem 0.25rem;
			border-right: 1px solid rgb(var(--gray-light));
		}
		.desktop-tags {
			display: block;
		}
		.mobile-tags {
			display: none;
		}
	}
</style>
