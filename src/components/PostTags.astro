---
import { type BlogTag, tagPath } from '../tags';

interface Props {
	tags: readonly BlogTag[];
	centered?: boolean;
}

const { tags, centered = false } = Astro.props;
---

{tags.length > 0 && (
	<nav class:list={['post-tags', { centered }]} aria-label="Post tags">
		{tags.map((tag) => <a href={tagPath(tag)} rel="tag">{tag}</a>)}
	</nav>
)}

<style>
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block: 1rem;
	}
	.centered {
		justify-content: center;
	}
	a {
		display: inline-flex;
		align-items: center;
		box-sizing: border-box;
		min-height: 44px;
		padding: 0.35rem 0.8rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		background: #f3f6fa;
		color: var(--accent-dark);
		font-size: 0.8rem;
		line-height: 1.4;
		text-decoration: none;
	}
	a:hover {
		border-color: var(--accent);
		background: #e2e9f3;
	}
	a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
</style>
